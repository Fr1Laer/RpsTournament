<Window x:Class="RpsTournament.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RpsTournament.WpfApp"
        mc:Ignorable="d"
        Title="RpsTournament" Height="450" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Mängija nimi:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="16"/>
            <TextBox x:Name="PlayerNameTextBox" Width="150" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="16"/>
            <Button x:Name="NewTournamentButton" Content="Uus turniir" Click="NewTournamentButton_Click" Padding="10,5" FontSize="16"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Vali käik:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="16"/>
            <ComboBox x:Name="PlayerMoveComboBox" Width="120" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="16"/>
            <Button x:Name="PlayRoundButton" Content="Mängi voor" Click="PlayRoundButton_Click" Padding="15,5" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Foreground="Red" Margin="0,0,0,10" FontWeight="SemiBold"/>

        <DataGrid x:Name="RoundsDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10" FontSize="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="*"/>
                <DataGridTextColumn Header="Player Move" Binding="{Binding PlayerMove}" Width="*"/>
                <DataGridTextColumn Header="Computer Move" Binding="{Binding ComputerMove}" Width="*"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ScoreTextBlock" Grid.Row="4" FontSize="16" HorizontalAlignment="Right" Text="Võite: 0 | Kaotusi: 0 | Viike: 0"/>
    </Grid>
</Window>
